# ── Supabase (Journal) ────────────────────────────────────────────
# La clave anon es pública por diseño: lo que protege los datos son
# las políticas RLS. Los nombres VITE_* antiguos también se aceptan.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# ── GitHub (solo servidor) ────────────────────────────────────────
# Token de solo lectura (fine-grained, "Public repositories"). Sin él
# el sitio sirve el snapshot de src/data/github-snapshot.json en vez
# de pedir datos en vivo: la API anónima solo da 60 peticiones/hora.
# NUNCA con prefijo NEXT_PUBLIC_.
GITHUB_TOKEN=

# ── Sitio ─────────────────────────────────────────────────────────
# URL canónica, sin barra final. Se usa en canonical, OpenGraph y sitemap.
NEXT_PUBLIC_SITE_URL=https://www.sackito.online

# Secreto opcional para /api/revalidate desde fuera (webhook de GitHub).
REVALIDATE_SECRET=
